<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071321">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 SKYBRIDGE NETWORKS"
            android:textColor="#55D6FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANDROID NETWORK SCANNER"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="20dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="READY TO SCAN"
            android:textColor="#55D6FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="15dp" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SCAN NEARBY WI-FI" />

        <TextView
            android:id="@+id/resultsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nearby Wi-Fi networks will appear here."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:paddingTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SkyBridge detects network names and signal strength. It does not bypass Wi-Fi passwords or intercept satellite signals."
            android:textColor="#A9B8C8"
            android:textSize="12sp"
            android:paddingTop="25dp" />

    </LinearLayout>
</ScrollView>
